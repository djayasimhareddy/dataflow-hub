# Postgres — used by Airflow's own metadata DB connection AND by
# pipelines/load.py, dbt, and great_expectations to reach
# raw_stock_prices / Silver / Gold tables in the same instance.
POSTGRES_DB=dataflow_hub
POSTGRES_USER=dataflow
POSTGRES_PASSWORD=970070

# ALPHA_VANTAGE_API_KEY is deliberately NOT here — it's set as an
# Airflow Variable instead (app-level secret Airflow reads at task
# runtime), not an env var every container needs at startup:
#
#   docker compose exec airflow-webserver \
#     airflow variables set ALPHA_VANTAGE_API_KEY your_key_here
